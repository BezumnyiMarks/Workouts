<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/workoutsListFragment">

    <fragment
        android:id="@+id/workoutsListFragment"
        android:name="com.example.kolsa.fragments.WorkoutsListFragment"
        android:label="WorkoutsListFragment" >
        <action
            android:id="@+id/action_workoutsListFragment_to_videoFragment"
            app:destination="@id/videoFragment" />
    </fragment>
    <fragment
        android:id="@+id/videoFragment"
        android:name="com.example.todolist.fragments.VideoFragment"
        android:label="VideoFragment" />
    <argument
        android:name="id"
        app:argType="long" />
    <argument
        android:name="desc"
        app:argType="string" />
</navigation>